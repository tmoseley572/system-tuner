# Which PHP handlers Apache can use (from loaded modules), plus cPanel's
# per-version handler map. Domains on PHP-FPM are found via pool files below.
detect_php_handlers() {
    PHP_HANDLERS=()
    CPANEL_PHP_HANDLERS=""

    local mods="" bin
    [[ ${#APACHE_BINARIES[@]} -eq 0 ]] && discover_apache_binaries
    if (( ${#APACHE_BINARIES[@]} > 0 )); then
        for bin in "${APACHE_BINARIES[@]}"; do
            mods=$("$bin" -M 2>/dev/null || true)
            [[ -n "$mods" ]] && break
        done
    fi

    grep -Eq '^[[:space:]]*php[0-9]*_module' <<<"$mods" && PHP_HANDLERS+=("mod_php")
    grep -q 'proxy_fcgi_module' <<<"$mods" && PHP_HANDLERS+=("proxy_fcgi")
    grep -q 'suphp_module' <<<"$mods" && PHP_HANDLERS+=("suphp")
    grep -q 'lsapi_module' <<<"$mods" && PHP_HANDLERS+=("lsapi")
    grep -q 'ruid2_module' <<<"$mods" && PHP_HANDLERS+=("ruid2")

    if [[ "${IS_CPANEL:-0}" -eq 1 && -r /etc/cpanel/ea4/php.conf ]]; then
        CPANEL_PHP_HANDLERS=$(awk -F': *' '/^ea-php[0-9]+:/ { gsub(/[[:space:]]/, "", $2); printf "%s%s=%s", sep, $1, $2; sep="," }' /etc/cpanel/ea4/php.conf)
    fi
}

fpm_pool_files() {
    local -a globs=()
    if [[ -n "${SMART_TUNER_FPM_POOL_GLOBS:-}" ]]; then
        read -r -a globs <<<"$SMART_TUNER_FPM_POOL_GLOBS"
    else
        globs=(
            "/opt/cpanel/ea-php*/root/etc/php-fpm.d/*.conf"
            "/etc/php-fpm.d/*.conf"
            "/etc/opt/remi/php*/php-fpm.d/*.conf"
            "/etc/php/*/fpm/pool.d/*.conf"
            "/usr/local/etc/php-fpm.d/*.conf"
        )
    fi

    local g f restore_nullglob
    restore_nullglob=$(shopt -p nullglob)
    shopt -s nullglob
    for g in "${globs[@]}"; do
        # shellcheck disable=SC2206  # intentional glob expansion
        for f in $g; do
            [[ -f "$f" ]] && printf '%s\n' "$f"
        done
    done
    eval "$restore_nullglob"
}

fpm_log_files() {
    local -a globs=()
    if [[ -n "${SMART_TUNER_FPM_LOG_GLOBS:-}" ]]; then
        read -r -a globs <<<"$SMART_TUNER_FPM_LOG_GLOBS"
    else
        globs=(
            "/opt/cpanel/ea-php*/root/usr/var/log/php-fpm/error.log"
            "/var/log/php-fpm/error.log"
            "/var/log/php*-fpm.log"
            "/var/opt/remi/php*/log/php-fpm/error.log"
        )
    fi

    local g f restore_nullglob
    restore_nullglob=$(shopt -p nullglob)
    shopt -s nullglob
    for g in "${globs[@]}"; do
        # shellcheck disable=SC2206
        for f in $g; do
            [[ -r "$f" ]] && printf '%s\n' "$f"
        done
    done
    eval "$restore_nullglob"
}

detect_phpfpm() {
    FPM_STATUS="not_detected"
    FPM_ACTIVE=0
    FPM_MASTERS=0
    FPM_WORKERS_NOW=0
    FPM_AVG_MB=0
    FPM_MEM_METHOD="none"
    FPM_POOL_COUNT=0
    FPM_SUM_MAX_CHILDREN=0
    FPM_TYPICAL_MAX_CHILDREN=0
    FPM_MODE_ONDEMAND=0
    FPM_MODE_DYNAMIC=0
    FPM_MODE_STATIC=0
    FPM_NO_MAX_REQUESTS=0
    FPM_LOG_FILES_SCANNED=0
    FPM_LOG_HITS=0
    FPM_POOL_NAMES=()
    FPM_POOL_MAX=()
    FPM_POOL_HITS=()

    # Running masters and pool workers (process titles set by php-fpm itself)
    local -a worker_pids=()
    local pid args
    while read -r pid args; do
        case "$args" in
            "php-fpm: master process"*) FPM_MASTERS=$((FPM_MASTERS + 1)) ;;
            "php-fpm: pool "*) worker_pids+=("$pid") ;;
        esac
    done < <(ps -eo pid=,args= 2>/dev/null)
    FPM_WORKERS_NOW=${#worker_pids[@]}

    # Pool definitions
    local -a files=()
    local f
    while IFS= read -r f; do
        [[ -n "$f" ]] && files+=("$f")
    done < <(fpm_pool_files)

    if (( ${#files[@]} > 0 )); then
        local name pm mc mr
        declare -A mc_freq=()
        while IFS='|' read -r name pm mc mr; do
            [[ -z "$name" ]] && continue
            FPM_POOL_COUNT=$((FPM_POOL_COUNT + 1))
            FPM_POOL_NAMES+=("$name")
            [[ "$mc" =~ ^[0-9]+$ ]] || mc=0
            FPM_POOL_MAX+=("$mc")
            FPM_SUM_MAX_CHILDREN=$((FPM_SUM_MAX_CHILDREN + mc))
            (( mc > 0 )) && mc_freq[$mc]=$(( ${mc_freq[$mc]:-0} + 1 ))
            case "${pm,,}" in
                ondemand) FPM_MODE_ONDEMAND=$((FPM_MODE_ONDEMAND + 1)) ;;
                static)   FPM_MODE_STATIC=$((FPM_MODE_STATIC + 1)) ;;
                *)        FPM_MODE_DYNAMIC=$((FPM_MODE_DYNAMIC + 1)) ;;
            esac
            [[ "$mr" =~ ^[0-9]+$ && "$mr" -gt 0 ]] || FPM_NO_MAX_REQUESTS=$((FPM_NO_MAX_REQUESTS + 1))
        done < <(awk '
            function flush() {
                if (name != "" && tolower(name) != "global") printf "%s|%s|%s|%s\n", name, pm, mc, mr
                name = ""
            }
            FNR == 1 { flush() }
            /^[[:space:]]*[;#]/ { next }
            /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
                flush()
                s = $0
                gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", s)
                name = s; pm = "dynamic"; mc = ""; mr = "0"
                next
            }
            name != "" && index($0, "=") > 0 {
                key = $0; sub(/=.*/, "", key); gsub(/[[:space:]]/, "", key)
                val = $0; sub(/^[^=]*=/, "", val); sub(/[;#].*$/, "", val)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", val); gsub(/["\047]/, "", val)
                if (key == "pm") pm = val
                else if (key == "pm.max_children") mc = val
                else if (key == "pm.max_requests") mr = val
            }
            END { flush() }
        ' "${files[@]}" 2>/dev/null)

        local best_count=0 v
        if (( ${#mc_freq[@]} > 0 )); then
            for v in "${!mc_freq[@]}"; do
                if (( mc_freq[$v] > best_count )); then
                    best_count=${mc_freq[$v]}
                    FPM_TYPICAL_MAX_CHILDREN=$v
                fi
            done
        fi
    fi

    if (( FPM_MASTERS > 0 )); then
        FPM_STATUS="running"
        FPM_ACTIVE=1
    elif (( FPM_POOL_COUNT > 0 )); then
        FPM_STATUS="configured_not_running"
    fi

    # Average worker footprint (sample up to 300 workers)
    if (( FPM_WORKERS_NOW > 0 )); then
        measure_pids_avg_mb "${worker_pids[@]:0:300}"
        if (( MEASURE_COUNT > 0 )); then
            FPM_AVG_MB=$MEASURE_AVG_MB
            FPM_MEM_METHOD=$MEASURE_METHOD
        fi
    fi
    if (( FPM_AVG_MB <= 0 )); then
        FPM_AVG_MB=$FPM_DEFAULT_WORKER_MB
        FPM_MEM_METHOD="default"
    elif (( FPM_AVG_MB < FPM_MIN_WORKER_MB )); then
        # Idle pre-forked workers understate a busy PHP request
        FPM_AVG_MB=$FPM_MIN_WORKER_MB
        FPM_MEM_METHOD="${FPM_MEM_METHOD}+floor"
    fi

    # "server reached pm.max_children" warnings in recent FPM error log lines
    local logf pool
    while IFS= read -r logf; do
        [[ -z "$logf" ]] && continue
        FPM_LOG_FILES_SCANNED=$((FPM_LOG_FILES_SCANNED + 1))
        while IFS= read -r pool; do
            [[ -z "$pool" ]] && continue
            FPM_POOL_HITS[$pool]=$(( ${FPM_POOL_HITS[$pool]:-0} + 1 ))
            FPM_LOG_HITS=$((FPM_LOG_HITS + 1))
        done < <(tail -n "$FPM_LOG_TAIL_LINES" "$logf" 2>/dev/null \
                    | grep -E 'reached (pm\.)?max_children' \
                    | sed -nE 's/.*\[pool ([^]]+)\].*/\1/p')
    done < <(fpm_log_files)
}

