# Average memory per process for a list of PIDs. Uses PSS (shared pages such as
# OPcache split across workers) when every PID is readable, else falls back to RSS.
# Sets MEASURE_AVG_MB, MEASURE_COUNT, MEASURE_METHOD.
measure_pids_avg_mb() {
    MEASURE_AVG_MB=0
    MEASURE_COUNT=0
    MEASURE_METHOD="pss"

    local pid kb total_kb=0 count=0
    for pid in "$@"; do
        [[ -e "/proc/$pid" ]] || continue
        kb=""
        if [[ -r "/proc/$pid/smaps_rollup" ]]; then
            kb=$(awk '/^Pss:/ {print $2; exit}' "/proc/$pid/smaps_rollup" 2>/dev/null)
        fi
        if [[ ! "$kb" =~ ^[0-9]+$ ]]; then
            MEASURE_METHOD="rss"
            break
        fi
        total_kb=$((total_kb + kb))
        count=$((count + 1))
    done

    if [[ "$MEASURE_METHOD" == "rss" ]]; then
        total_kb=0
        count=0
        for pid in "$@"; do
            kb=$(ps -o rss= -p "$pid" 2>/dev/null | tr -d '[:space:]')
            [[ "$kb" =~ ^[0-9]+$ ]] || continue
            total_kb=$((total_kb + kb))
            count=$((count + 1))
        done
    fi

    MEASURE_COUNT=$count
    if (( count > 0 )); then
        MEASURE_AVG_MB=$(( (total_kb / count + 1023) / 1024 ))
    fi
}

set_stack_shares() {
    local default_share
    case "$TIER" in
        LOW)      default_share="0.15"; OS_RESERVE_PCT="0.15" ;;
        LOW-MID)  default_share="0.20"; OS_RESERVE_PCT="0.12" ;;
        MID)      default_share="0.25"; OS_RESERVE_PCT="0.10" ;;
        MID-HIGH) default_share="0.25"; OS_RESERVE_PCT="0.10" ;;
        *)        default_share="0.30"; OS_RESERVE_PCT="0.10" ;;
    esac

    if [[ -n "$MYSQL_SHARE_OVERRIDE" ]]; then
        MYSQL_SHARE="$MYSQL_SHARE_OVERRIDE"
        MYSQL_SHARE_SOURCE="override"
    else
        MYSQL_SHARE="$default_share"
        MYSQL_SHARE_SOURCE="tier"
    fi

    OS_RESERVE_MB=$(pct_of_total_mb "$OS_RESERVE_PCT")
    (( OS_RESERVE_MB < 512 )) && OS_RESERVE_MB=512
    (( OS_RESERVE_MB > 4096 )) && OS_RESERVE_MB=4096
}

has_php_handler() {
    local want="$1" h
    (( ${#PHP_HANDLERS[@]} > 0 )) || return 1
    for h in "${PHP_HANDLERS[@]}"; do
        [[ "$h" == "$want" ]] && return 0
    done
    return 1
