run_analysis_pipeline() {
    set_tier_params
    measure_apache_procs
    APACHE_TIER_BUDGET_MB=$APACHE_BUDGET_MB
    [[ "$STACK_ENABLED" -eq 1 ]] && compute_stack_plan
