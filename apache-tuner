detect_mysql() {
    MYSQL_STATUS="absent"
    MYSQL_RUNNING=0
    MYSQL_RSS_MB=0
    MYSQL_VARS_SOURCE="none"
    MYSQL_VERSION="unknown"
    MYSQL_FLAVOR="mysql"
    MYSQL_INNODB_DATA_MB=0
    MYV=()

    local name kb rss_kb=0
    for name in mariadbd mysqld; do
        kb=$(ps -C "$name" -o rss= 2>/dev/null | awk '{ s += $1 } END { print s + 0 }')
        [[ "$kb" =~ ^[0-9]+$ ]] && rss_kb=$((rss_kb + kb))
    done
    MYSQL_RSS_MB=$((rss_kb / 1024))

    if (( rss_kb == 0 )); then
        if command -v mysqld >/dev/null 2>&1 || command -v mariadbd >/dev/null 2>&1; then
            MYSQL_STATUS="installed_not_running"
        fi
        return
    fi
    MYSQL_RUNNING=1
    MYSQL_STATUS="running"

    local out="" k v line
    if command -v mysql >/dev/null 2>&1; then
        out=$(run_with_timeout 10 mysql --batch --skip-column-names --connect-timeout=5 \
                -e "SHOW GLOBAL VARIABLES; SHOW GLOBAL STATUS WHERE Variable_name IN ('Max_used_connections','Uptime')" \
                </dev/null 2>/dev/null || true)
    fi

    if [[ -n "$out" ]]; then
        MYSQL_VARS_SOURCE="live"
        while IFS=$'\t' read -r k v; do
            [[ -n "$k" ]] && MYV[$k]="$v"
        done <<<"$out"
    elif command -v my_print_defaults >/dev/null 2>&1; then
        out=$(my_print_defaults mysqld server mariadb 2>/dev/null || true)
        if [[ -n "$out" ]]; then
            MYSQL_VARS_SOURCE="config"
            while IFS= read -r line; do
                line=${line#--}
                [[ "$line" == *=* ]] || continue
                k=${line%%=*}
                v=${line#*=}
                MYV[${k//-/_}]="$v"
            done <<<"$out"
        fi
    fi

    if [[ "$MYSQL_VARS_SOURCE" == "none" ]]; then
        MYSQL_STATUS="running_no_access"
        return
    fi

    MYSQL_VERSION="${MYV[version]:-unknown}"
    if [[ "${MYV[version]:-}${MYV[version_comment]:-}" == *[Mm]aria[Dd][Bb]* ]]; then
        MYSQL_FLAVOR="mariadb"
    fi

    # InnoDB data+index size caps a useful buffer pool. Bounded server-side so a
    # host with many tables cannot be loaded down by information_schema.
    if [[ "$MYSQL_VARS_SOURCE" == "live" ]]; then
        local q="SELECT COALESCE(SUM(data_length + index_length), 0) FROM information_schema.tables WHERE engine = 'InnoDB'"
        if [[ "$MYSQL_FLAVOR" == "mariadb" ]]; then
            q="SET STATEMENT max_statement_time=10 FOR $q"
        else
            q="SELECT /*+ MAX_EXECUTION_TIME(10000) */ ${q#SELECT }"
        fi
        local size
        size=$(run_with_timeout 15 mysql --batch --skip-column-names --connect-timeout=5 -e "$q" </dev/null 2>/dev/null | tail -n 1)
        [[ "$size" =~ ^[0-9]+$ ]] && MYSQL_INNODB_DATA_MB=$(bytes_to_mb "$size")
    fi
}

recommend_mysql() {
    MYSQL_BP_MB=0
    MYSQL_REC_BP_MB=0
    MYSQL_MAX_CONN=0
    MYSQL_REC_MAX_CONN=0
    MYSQL_MAX_USED=""
    MYSQL_UPTIME=""
    MYSQL_PEAK_MB=0
    MYSQL_REC_PEAK_MB=0
    MYSQL_REC_FOOTPRINT_MB=0
    MYSQL_TARGET_MB=$(pct_of_total_mb "$MYSQL_SHARE")

    [[ "$MYSQL_RUNNING" -eq 1 && "$MYSQL_VARS_SOURCE" != "none" ]] || return

    local MB=1048576
    local bp_b key_b tmp_b heap_b logbuf_b qc_b aria_b
    bp_b=$(mysql_var_bytes innodb_buffer_pool_size 134217728)
    key_b=$(mysql_var_bytes key_buffer_size 8388608)
    tmp_b=$(mysql_var_bytes tmp_table_size 16777216)
    heap_b=$(mysql_var_bytes max_heap_table_size 16777216)
    logbuf_b=$(mysql_var_bytes innodb_log_buffer_size 16777216)
    qc_b=$(mysql_var_bytes query_cache_size 0)
    aria_b=$(mysql_var_bytes aria_pagecache_buffer_size 0)

    local sort_b join_b read_b rnd_b stack_b binlog_b
    sort_b=$(mysql_var_bytes sort_buffer_size 262144)
    join_b=$(mysql_var_bytes join_buffer_size 262144)
    read_b=$(mysql_var_bytes read_buffer_size 131072)
    rnd_b=$(mysql_var_bytes read_rnd_buffer_size 262144)
    stack_b=$(mysql_var_bytes thread_stack 262144)
    binlog_b=$(mysql_var_bytes binlog_cache_size 32768)

    local per_thread_b=$(( sort_b + join_b + read_b + rnd_b + stack_b + binlog_b ))
    (( per_thread_b < 1 )) && per_thread_b=1
    MYSQL_PER_THREAD_KB=$(( per_thread_b / 1024 ))

    # In-memory temp tables are bounded by the smaller of the two settings
    local tmp_eff_b=$(( tmp_b < heap_b ? tmp_b : heap_b ))
    MYSQL_TMP_MB=$(bytes_to_mb "$tmp_b")
    MYSQL_HEAP_MB=$(bytes_to_mb "$heap_b")
    local other_b=$(( key_b + tmp_eff_b + logbuf_b + qc_b + aria_b ))
    MYSQL_OTHER_MB=$(( (other_b + MB - 1) / MB ))
    MYSQL_BP_MB=$(bytes_to_mb "$bp_b")

    MYSQL_MAX_CONN="${MYV[max_connections]:-151}"
    [[ "$MYSQL_MAX_CONN" =~ ^[0-9]+$ ]] || MYSQL_MAX_CONN=151
    [[ "${MYV[Max_used_connections]:-}" =~ ^[0-9]+$ ]] && MYSQL_MAX_USED="${MYV[Max_used_connections]}"
    [[ "${MYV[Uptime]:-}" =~ ^[0-9]+$ ]] && MYSQL_UPTIME="${MYV[Uptime]}"

    MYSQL_PEAK_MB=$(( (bp_b + other_b + MYSQL_MAX_CONN * per_thread_b) / MB ))

    # --- max_connections ---
    local need=100
    if [[ -n "$MYSQL_MAX_USED" ]]; then
        need=$(( (MYSQL_MAX_USED * 3 + 1) / 2 ))
        (( need < 100 )) && need=100
    fi
    MYSQL_REC_MAX_CONN=$MYSQL_MAX_CONN
    if [[ -n "$MYSQL_MAX_USED" ]] && (( MYSQL_MAX_USED * 10 >= MYSQL_MAX_CONN * 9 )); then
        MYSQL_REC_MAX_CONN=$need
    fi

    # Connections we expect to be live at once when sizing the pool
    local conn_basis
    if [[ -n "$MYSQL_MAX_USED" ]]; then
        conn_basis=$(( (MYSQL_MAX_USED * 5 + 3) / 4 ))
        (( conn_basis < 20 )) && conn_basis=20
    else
        conn_basis=$(( MYSQL_MAX_CONN < 100 ? MYSQL_MAX_CONN : 100 ))
    fi
    (( conn_basis > MYSQL_REC_MAX_CONN )) && conn_basis=$MYSQL_REC_MAX_CONN
    local conn_mb=$(( (conn_basis * per_thread_b + MB - 1) / MB ))

    # --- innodb_buffer_pool_size ---
    local pool=$(( MYSQL_TARGET_MB - MYSQL_OTHER_MB - conn_mb ))
    local pool_note="fits ${MYSQL_SHARE} of RAM (${MYSQL_TARGET_MB} MB) after other buffers and ~${conn_basis} connections"
    if (( MYSQL_INNODB_DATA_MB > 0 )); then
        local cap=$(( MYSQL_INNODB_DATA_MB * 5 / 4 ))
        (( cap < 128 )) && cap=128
        if (( pool > cap )); then
            pool=$cap
            pool_note="InnoDB data is ${MYSQL_INNODB_DATA_MB} MB; pool sized to data + 25%"
        fi
    fi
    (( pool < 128 )) && pool=128
    pool=$(( pool / 128 * 128 ))
    (( pool < 128 )) && pool=128
    local diff=$(( pool - MYSQL_BP_MB ))
    (( diff < 0 )) && diff=$(( -diff ))
    if (( diff * 10 <= MYSQL_BP_MB )); then
        pool=$MYSQL_BP_MB
    fi
    MYSQL_REC_BP_MB=$pool

    # Keep the worst case (every allowed connection busy) within share + 10% of RAM
    local allowed=$(( MYSQL_TARGET_MB + TOTAL_MEM / 10 ))
    local worst=$(( MYSQL_OTHER_MB + pool + (MYSQL_REC_MAX_CONN * per_thread_b) / MB ))
    if (( worst > allowed )) && [[ -n "$MYSQL_MAX_USED" ]]; then
        local fit=$(( (allowed - MYSQL_OTHER_MB - pool) * MB / per_thread_b ))
        (( fit < need )) && fit=$need
        (( fit < MYSQL_REC_MAX_CONN )) && MYSQL_REC_MAX_CONN=$fit
    fi

    MYSQL_REC_FOOTPRINT_MB=$(( MYSQL_OTHER_MB + pool + conn_mb ))
    MYSQL_REC_PEAK_MB=$(( MYSQL_OTHER_MB + pool + (MYSQL_REC_MAX_CONN * per_thread_b) / MB ))

    # --- recommendations ---
    if (( MYSQL_REC_BP_MB != MYSQL_BP_MB )); then
        add_stack_rec "[MySQL] innodb_buffer_pool_size ${MYSQL_BP_MB}M => ${MYSQL_REC_BP_MB}M (${pool_note})."
    fi
    if (( MYSQL_REC_MAX_CONN != MYSQL_MAX_CONN )); then
        if (( MYSQL_REC_MAX_CONN > MYSQL_MAX_CONN )); then
            add_stack_rec "[MySQL] max_connections ${MYSQL_MAX_CONN} => ${MYSQL_REC_MAX_CONN}: Max_used_connections (${MYSQL_MAX_USED}) reached 90%+ of the limit."
        else
            add_stack_rec "[MySQL] max_connections ${MYSQL_MAX_CONN} => ${MYSQL_REC_MAX_CONN}: at ${MYSQL_PER_THREAD_KB} KB/connection the current limit could use more RAM than planned (peak used: ${MYSQL_MAX_USED})."
        fi
    fi
    if [[ "${MYV[query_cache_type]:-OFF}" =~ ^(ON|1|DEMAND|2)$ ]] && (( qc_b > 0 )); then
        MYSQL_QUERY_CACHE_ON=1
        add_stack_rec "[MySQL] Query cache is enabled ($(bytes_to_mb "$qc_b") MB); set query_cache_type = 0 and query_cache_size = 0 to avoid global mutex contention."
    fi
    if (( tmp_b != heap_b )); then
        add_stack_rec "[MySQL] tmp_table_size (${MYSQL_TMP_MB}M) and max_heap_table_size (${MYSQL_HEAP_MB}M) differ; the smaller one wins, so set both to the same value."
    fi
    if [[ -n "$MYSQL_UPTIME" ]] && (( MYSQL_UPTIME < 86400 )); then
        add_stack_rec "[MySQL] Server uptime is under 24h; Max_used_connections may understate real peak load. Re-run after a full day."
    fi
    if (( MYSQL_PEAK_MB > TOTAL_MEM )); then
        add_stack_rec "[MySQL] Current worst-case memory (${MYSQL_PEAK_MB} MB with all ${MYSQL_MAX_CONN} connections busy) exceeds total RAM (${TOTAL_MEM} MB)."
    fi
    if [[ "$MYSQL_VARS_SOURCE" == "config" ]]; then
        add_stack_rec "[MySQL] Live variables unavailable (sized from my.cnf + server defaults). Run as root or provide ~/.my.cnf credentials for live values."
    fi
}

# Build the shared RAM plan before Apache sizing. Lowers APACHE_BUDGET_MB (never
# raises it) when OS reserve + MySQL + PHP-FPM leave less than the tier share.
compute_stack_plan() {
    STACK_RECS=()
    APACHE_TIER_BUDGET_MB=$APACHE_BUDGET_MB
    set_stack_shares
    detect_php_handlers
    detect_phpfpm
    detect_mysql
    recommend_mysql

    MYSQL_RESERVE_MB=0
    if [[ "$MYSQL_RUNNING" -eq 1 ]]; then
        MYSQL_RESERVE_MB=$MYSQL_RSS_MB
        (( MYSQL_REC_FOOTPRINT_MB > MYSQL_RESERVE_MB )) && MYSQL_RESERVE_MB=$MYSQL_REC_FOOTPRINT_MB
    fi

    WEB_BUDGET_MB=$(( TOTAL_MEM - OS_RESERVE_MB - MYSQL_RESERVE_MB ))
    (( WEB_BUDGET_MB < 0 )) && WEB_BUDGET_MB=0

    # With PHP in FPM, httpd children no longer carry PHP, so Apache needs only a
    # slice of the web budget. With mod_php loaded, PHP still lives in httpd.
    APACHE_WEB_SHARE="1.00"
    if [[ "$FPM_ACTIVE" -eq 1 ]] && ! has_php_handler "mod_php"; then
        APACHE_WEB_SHARE="$APACHE_WEB_SHARE_WITH_FPM"
    fi

    local plan_apache
    plan_apache=$(awk -v w="$WEB_BUDGET_MB" -v s="$APACHE_WEB_SHARE" 'BEGIN { printf "%.0f", w * s }')

    if [[ -z "$BUDGET_OVERRIDE" ]] && (( plan_apache < APACHE_BUDGET_MB )); then
        APACHE_BUDGET_MB=$plan_apache
        BUDGET_SOURCE="shared-plan"
        APACHE_PCT=$(awk -v b="$APACHE_BUDGET_MB" -v t="$TOTAL_MEM" 'BEGIN { printf "%.2f", b / t }')
    fi
}

# After the Apache block is built: give PHP-FPM what is left and size pools.
finalize_stack_plan() {
    if [[ "$MPM_TYPE" == "prefork" ]]; then
        APACHE_USED_MB=$(( MAX_WORKERS * AVG_PROC_MB ))
    else
        local procs=$(( (MAX_WORKERS + THREADS_PER_CHILD - 1) / THREADS_PER_CHILD ))
        APACHE_USED_MB=$(( procs * AVG_PROC_MB ))
    fi

    PLAN_OVERCOMMIT_MB=$(( OS_RESERVE_MB + MYSQL_RESERVE_MB + APACHE_USED_MB - TOTAL_MEM ))
    (( PLAN_OVERCOMMIT_MB < 0 )) && PLAN_OVERCOMMIT_MB=0
    if (( PLAN_OVERCOMMIT_MB > 0 )); then
        add_stack_rec "[PLAN] OS reserve + MySQL + Apache worst case exceed RAM by ${PLAN_OVERCOMMIT_MB} MB (Apache floors/caps are fixed by tier). Consider more RAM or a smaller MySQL share."
    fi

    FPM_BUDGET_MB=0
    FPM_CAPACITY=0
    FPM_REC_MAX_CHILDREN=0
    FPM_OVERCOMMIT=1

    if [[ "$FPM_STATUS" == "configured_not_running" ]]; then
        add_stack_rec "[FPM] ${FPM_POOL_COUNT} pool file(s) found but no php-fpm master is running; FPM is not counted in the plan."
    fi
    if [[ "$FPM_ACTIVE" -ne 1 ]]; then
        if has_php_handler "suphp" || has_php_handler "lsapi"; then
            add_stack_rec "[PLAN] PHP runs outside httpd via $(has_php_handler lsapi && echo lsapi || echo suphp/CGI); those processes are not sized here, which is why the Apache share stays at the tier limit."
        fi
        return
    fi

    FPM_BUDGET_MB=$(( WEB_BUDGET_MB - APACHE_USED_MB ))
    if (( FPM_BUDGET_MB <= 0 )); then
        FPM_BUDGET_MB=0
        add_stack_rec "[FPM] No RAM left for PHP-FPM after OS, MySQL and Apache; PHP workers will push the server into swap under load."
        return
    fi
    FPM_CAPACITY=$(( FPM_BUDGET_MB / FPM_AVG_MB ))

    local mysql_excess=$(( MYSQL_RSS_MB - MYSQL_REC_FOOTPRINT_MB ))
    if (( MYSQL_REC_FOOTPRINT_MB > 0 && mysql_excess * 10 > MYSQL_RSS_MB )); then
        add_stack_rec "[PLAN] MySQL currently holds ${MYSQL_RSS_MB} MB; with the MySQL changes above it would need ~${MYSQL_REC_FOOTPRINT_MB} MB, freeing ~${mysql_excess} MB for PHP-FPM. Re-run after changing MySQL before raising FPM limits."
    fi

    # Per-pool pm.max_children. Idle ondemand pools hold no workers, so when most
    # pools are ondemand allow 3x overcommit across pools; otherwise none.
    if (( FPM_POOL_COUNT > 0 && FPM_MODE_ONDEMAND * 2 > FPM_POOL_COUNT )); then
        FPM_OVERCOMMIT=3
    fi
    if (( FPM_POOL_COUNT <= 1 )); then
        FPM_REC_MAX_CHILDREN=$FPM_CAPACITY
    else
        FPM_REC_MAX_CHILDREN=$(( FPM_CAPACITY * FPM_OVERCOMMIT / FPM_POOL_COUNT ))
    fi
    (( FPM_REC_MAX_CHILDREN < 5 )) && FPM_REC_MAX_CHILDREN=5
    (( FPM_REC_MAX_CHILDREN > FPM_CAPACITY )) && FPM_REC_MAX_CHILDREN=$FPM_CAPACITY
    (( FPM_REC_MAX_CHILDREN < 1 )) && FPM_REC_MAX_CHILDREN=1

    if (( FPM_TYPICAL_MAX_CHILDREN > 0 && FPM_TYPICAL_MAX_CHILDREN != FPM_REC_MAX_CHILDREN )); then
        local where="each pool"
        if [[ "${IS_CPANEL:-0}" -eq 1 ]]; then
            where="WHM > MultiPHP Manager > System PHP-FPM Settings (pm_max_children in /var/cpanel/ApachePHPFPM/system_pool_defaults.yaml), then /scripts/php_fpm_config --rebuild; per-domain overrides in /var/cpanel/userdata/*/*.php_fpm.yaml still win"
        fi
        add_stack_rec "[FPM] pm.max_children ${FPM_TYPICAL_MAX_CHILDREN} => ${FPM_REC_MAX_CHILDREN} (RAM for ~${FPM_CAPACITY} workers at ${FPM_AVG_MB} MB across ${FPM_POOL_COUNT} pools, ${FPM_OVERCOMMIT}x overcommit). Set in ${where}."
    fi

    local worst_mb=$(( FPM_SUM_MAX_CHILDREN * FPM_AVG_MB ))
    if (( FPM_SUM_MAX_CHILDREN > FPM_CAPACITY * FPM_OVERCOMMIT )); then
        add_stack_rec "[FPM] Sum of pm.max_children is ${FPM_SUM_MAX_CHILDREN} (~${worst_mb} MB) vs. a budget of ${FPM_BUDGET_MB} MB (~${FPM_CAPACITY} workers). Simultaneous load across pools can exhaust RAM."
    fi

    local i big=()
    for (( i = 0; i < ${#FPM_POOL_NAMES[@]}; i++ )); do
        (( FPM_POOL_MAX[i] > FPM_CAPACITY )) && big+=("${FPM_POOL_NAMES[i]}(${FPM_POOL_MAX[i]})")
    done
    if (( ${#big[@]} > 0 )); then
        add_stack_rec "[FPM] ${#big[@]} pool(s) allow more children than the whole FPM budget can hold (~${FPM_CAPACITY}): ${big[*]:0:5}$( (( ${#big[@]} > 5 )) && echo ' ...')."
    fi

    if (( FPM_LOG_HITS > 0 )); then
        local top
        top=$(for p in "${!FPM_POOL_HITS[@]}"; do printf '%s %s\n' "${FPM_POOL_HITS[$p]}" "$p"; done \
                | sort -rn | head -5 | awk '{ printf "%s%s(%s)", sep, $2, $1; sep=", " }')
        add_stack_rec "[FPM] ${FPM_LOG_HITS} 'reached pm.max_children' warnings in recent logs across ${#FPM_POOL_HITS[@]} pool(s): ${top}. Raise those pools individually (ceiling ~${FPM_CAPACITY}) before raising the default."
    fi

    if (( FPM_NO_MAX_REQUESTS > 0 )); then
        add_stack_rec "[FPM] ${FPM_NO_MAX_REQUESTS} pool(s) have pm.max_requests = 0 (workers never recycle); set pm.max_requests = 500 to contain memory leaks."
    fi

    if (( FPM_POOL_COUNT >= 20 && FPM_MODE_DYNAMIC + FPM_MODE_STATIC > FPM_POOL_COUNT / 4 )); then
        add_stack_rec "[FPM] $(( FPM_MODE_DYNAMIC + FPM_MODE_STATIC )) of ${FPM_POOL_COUNT} pools use dynamic/static; on a multi-tenant box pm = ondemand keeps idle sites from holding workers."
    fi
}

stack_handlers_csv() {
    local IFS=,
    if (( ${#PHP_HANDLERS[@]} > 0 )); then
        echo "${PHP_HANDLERS[*]}"
    else
        echo "none"
    fi
}

fpm_status_text() {
    case "$FPM_STATUS" in
        running) echo "running (${FPM_MASTERS} master(s), ${FPM_WORKERS_NOW} worker(s) now)" ;;
        configured_not_running) echo "pool files found, no master running" ;;
        not_detected) echo "not detected" ;;
        *) echo "$FPM_STATUS" ;;
    esac
}

mysql_status_text() {
    case "$MYSQL_STATUS" in
        running)
            if [[ "$MYSQL_VERSION" == "unknown" ]]; then
                echo "running (variables: ${MYSQL_VARS_SOURCE})"
            else
                echo "running ${MYSQL_FLAVOR} ${MYSQL_VERSION} (variables: ${MYSQL_VARS_SOURCE})"
            fi
            ;;
        running_no_access) echo "running, but variables unreadable (run as root or add ~/.my.cnf)" ;;
        installed_not_running) echo "installed, not running" ;;
        absent) echo "not detected" ;;
        *) echo "$MYSQL_STATUS" ;;
    esac
}

print_stack_report() {
    echo "------------------------------------------------"
    echo " Server memory plan (shared by Apache, PHP-FPM, MySQL)"
    echo "------------------------------------------------"
    printf "  %-24s %8s MB\n" "Total RAM" "$TOTAL_MEM"
    printf "  %-24s %8s MB  (%s)\n" "OS / page cache reserve" "$OS_RESERVE_MB" "$OS_RESERVE_PCT of RAM, 512-4096 MB"
    if [[ "$MYSQL_RUNNING" -eq 1 ]]; then
        printf "  %-24s %8s MB  (%s)\n" "MySQL/MariaDB" "$MYSQL_RESERVE_MB" "max of current RSS ${MYSQL_RSS_MB} MB and recommended ${MYSQL_REC_FOOTPRINT_MB} MB"
    else
        printf "  %-24s %8s\n" "MySQL/MariaDB" "not running"
    fi
    printf "  %-24s %8s MB  (%s)\n" "Apache (worst case)" "$APACHE_USED_MB" "budget ${APACHE_BUDGET_MB} MB; tier budget ${APACHE_TIER_BUDGET_MB} MB; web share ${APACHE_WEB_SHARE}"
    if [[ "$FPM_ACTIVE" -eq 1 ]]; then
        printf "  %-24s %8s MB  (%s)\n" "PHP-FPM" "$FPM_BUDGET_MB" "~${FPM_CAPACITY} workers at ${FPM_AVG_MB} MB (${FPM_MEM_METHOD})"
    else
        printf "  %-24s %8s\n" "PHP-FPM" "n/a"
    fi
    (( PLAN_OVERCOMMIT_MB > 0 )) && printf "  %-24s %8s MB\n" "OVERCOMMITTED BY" "$PLAN_OVERCOMMIT_MB"

    echo "------------------------------------------------"
    echo " PHP-FPM (recommend-only; not applied)"
    echo "------------------------------------------------"
    echo "  Status:                 $(fpm_status_text)"
    echo "  Apache PHP modules:     $(stack_handlers_csv)"
    [[ -n "$CPANEL_PHP_HANDLERS" ]] && echo "  cPanel handlers:        $CPANEL_PHP_HANDLERS"
    if (( FPM_POOL_COUNT > 0 )); then
        echo "  Pools:                  ${FPM_POOL_COUNT} (ondemand ${FPM_MODE_ONDEMAND}, dynamic ${FPM_MODE_DYNAMIC}, static ${FPM_MODE_STATIC})"
        echo "  Sum of pm.max_children: ${FPM_SUM_MAX_CHILDREN}"
        echo "  max_children warnings:  ${FPM_LOG_HITS} (in ${FPM_LOG_FILES_SCANNED} log file(s))"
        if [[ "$FPM_ACTIVE" -eq 1 ]]; then
            print_current_vs_proposed "pm.max_children" "${FPM_TYPICAL_MAX_CHILDREN} (typical)" "$FPM_REC_MAX_CHILDREN"
        fi
    fi

    echo "------------------------------------------------"
    echo " MySQL/MariaDB (recommend-only; not applied)"
    echo "------------------------------------------------"
    echo "  Status:                 $(mysql_status_text)"
    if [[ "$MYSQL_RUNNING" -eq 1 && "$MYSQL_VARS_SOURCE" != "none" ]]; then
        echo "  Planned share:          ${MYSQL_SHARE} of RAM = ${MYSQL_TARGET_MB} MB (source: ${MYSQL_SHARE_SOURCE})"
        echo "  InnoDB data+index:      $( (( MYSQL_INNODB_DATA_MB > 0 )) && echo "${MYSQL_INNODB_DATA_MB} MB" || echo "unknown")"
        echo "  Per-connection buffers: ${MYSQL_PER_THREAD_KB} KB; peak connections used: ${MYSQL_MAX_USED:-unknown}"
        echo "  Worst case now:         ${MYSQL_PEAK_MB} MB => ${MYSQL_REC_PEAK_MB} MB"
        print_current_vs_proposed "innodb_buffer_pool_size" "${MYSQL_BP_MB}M" "${MYSQL_REC_BP_MB}M"
        print_current_vs_proposed "max_connections" "$MYSQL_MAX_CONN" "$MYSQL_REC_MAX_CONN"
        if (( MYSQL_REC_BP_MB != MYSQL_BP_MB || MYSQL_REC_MAX_CONN != MYSQL_MAX_CONN )); then
            echo
            echo "  # Suggested [mysqld] settings (not applied). innodb_buffer_pool_size can be"
            echo "  # changed live with SET GLOBAL on MySQL 5.7+/MariaDB 10.2+; persist it in my.cnf."
            echo "  [mysqld]"
            (( MYSQL_REC_BP_MB != MYSQL_BP_MB )) && echo "  innodb_buffer_pool_size = ${MYSQL_REC_BP_MB}M"
            (( MYSQL_REC_MAX_CONN != MYSQL_MAX_CONN )) && echo "  max_connections = ${MYSQL_REC_MAX_CONN}"
        fi
    fi

    echo "------------------------------------------------"
    echo " Stack recommendations"
    echo "------------------------------------------------"
    if (( ${#STACK_RECS[@]} == 0 )); then
        echo "  [OK] No PHP-FPM or MySQL changes recommended."
    else
        local r
        for r in "${STACK_RECS[@]}"; do
            echo "  - $r"
        done
    fi
}

build_stack_json() {
    local recs="" r sep=""
    if (( ${#STACK_RECS[@]} > 0 )); then
        for r in "${STACK_RECS[@]}"; do
            recs+="${sep}\"$(json_escape "$r")\""
            sep=", "
        done
    fi
    local hits="" p
    sep=""
    if (( ${#FPM_POOL_HITS[@]} > 0 )); then
        for p in "${!FPM_POOL_HITS[@]}"; do
            hits+="${sep}\"$(json_escape "$p")\": ${FPM_POOL_HITS[$p]}"
            sep=", "
        done
    fi
    local handlers="" h
    sep=""
    if (( ${#PHP_HANDLERS[@]} > 0 )); then
        for h in "${PHP_HANDLERS[@]}"; do
            handlers+="${sep}\"${h}\""
            sep=", "
        done
    fi
    local max_used="${MYSQL_MAX_USED:-null}"

