# ----------------- PHP-FPM / MySQL stack awareness -----------------
#
# The tier Apache budget is a fixed share of RAM. When PHP-FPM pools and a local
# MySQL/MariaDB share the box, all three must fit in the same RAM. These helpers
# measure both, size recommendations for them (never applied), and lower the
# Apache budget only when the tier share would not fit alongside them.

# Convert a MySQL-style size (bytes, or 512K / 128M / 1G / 1T) to bytes.
size_to_bytes() {
    local v="${1:-}"
    v="${v,,}"
    v="${v//[[:space:]]/}"
    case "$v" in
        *[0-9]k) awk -v n="${v%k}" 'BEGIN { printf "%.0f", n * 1024 }' ;;
        *[0-9]m) awk -v n="${v%m}" 'BEGIN { printf "%.0f", n * 1048576 }' ;;
        *[0-9]g) awk -v n="${v%g}" 'BEGIN { printf "%.0f", n * 1073741824 }' ;;
        *[0-9]t) awk -v n="${v%t}" 'BEGIN { printf "%.0f", n * 1099511627776 }' ;;
        ''|*[!0-9.]*) echo 0 ;;
        *) awk -v n="$v" 'BEGIN { printf "%.0f", n }' ;;
    esac
}

bytes_to_mb() {
    awk -v b="${1:-0}" 'BEGIN { printf "%.0f", b / 1048576 }'
}

pct_of_total_mb() {
    awk -v t="$TOTAL_MEM" -v p="$1" 'BEGIN { printf "%.0f", t * p }'
}

run_with_timeout() {
    local secs="$1"
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$secs" "$@"
    else
        "$@"
    fi
}

json_escape() {
    local v
    v=$(sanitize_value "${1:-}")
    v=${v//\\/\\\\}
    v=${v//\"/\\\"}
    printf '%s' "$v"
}

add_stack_rec() {
    STACK_RECS+=("$1")
